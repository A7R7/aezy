{
  "name": "@aezy/inspector",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only authoritative loop trace projection for Aezy Sessions",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./trace": {
      "types": "./src/trace.d.ts",
      "default": "./src/trace.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "src/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
