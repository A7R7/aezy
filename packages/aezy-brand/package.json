{
  "name": "@aezy/brand",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Aezy occupants for the DSH Web brand slots",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.4",
    "react": "^18.2.0"
  }
}
