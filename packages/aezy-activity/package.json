{
  "name": "@aezy/activity",
  "version": "0.0.0",
  "private": true,
  "description": "Thin DSH Activity, Status, Usage, and Notifications dashboard for Aezy",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session-stats": "0.1.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.1",
    "react": "^18.2.0"
  }
}
