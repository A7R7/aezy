{
  "name": "@aezy/workflow",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned declarative macro workflow definitions for Aezy",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./definition": {
      "types": "./src/definition.d.ts",
      "default": "./src/definition.js"
    },
    "./system": {
      "types": "./src/system.d.ts",
      "default": "./src/system.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "src/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
