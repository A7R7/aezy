{
  "name": "@aezy/workflow",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned declarative macro workflow definitions for Aezy",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./definition": {
      "types": "./src/definition.d.ts",
      "default": "./src/definition.js"
    },
    "./system": {
      "types": "./src/system.d.ts",
      "default": "./src/system.js"
    },
    "./editor": {
      "types": "./src/editor.d.ts",
      "default": "./src/editor.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "src/*.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "react": "^18.2.0"
  }
}
